# Copy this file to .env.local and paste your real keys there.
# Do not send .env.local to GitHub, chats, screenshots, or issue trackers.

GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional benchmark controls.
BENCHMARK_PROVIDERS=groq,nvidia,openrouter
BENCHMARK_ROUNDS=2
BENCHMARK_TIMEOUT_MS=30000
