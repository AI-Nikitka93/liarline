# Copy this file to .env.local and paste your real keys there.
# Do not send .env.local to GitHub, chats, screenshots, or issue trackers.

GROQ_API_KEY=
# Optional Groq backups for automatic server-side failover on 429/5xx/invalid-key responses.
# Separate keys with commas, semicolons, spaces, or new lines.
GROQ_API_KEYS=
# Optional numbered form if your host manages secrets one variable at a time.
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional benchmark controls.
BENCHMARK_PROVIDERS=groq,nvidia,openrouter
BENCHMARK_ROUNDS=2
BENCHMARK_TIMEOUT_MS=30000
